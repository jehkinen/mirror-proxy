{
  "manifest_version": 3,
  "name": "Mirror Proxy",
  "version": "1.13.0",
  "description": "Mirror Proxy — browser-only HTTP proxy",
  "author": "Andrei B",
  "homepage_url": "https://andydev.space/",
  "permissions": [
    "proxy",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mirror Proxy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
